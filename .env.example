# --- Servidor (node server/index.ts) ---
PORT=3001
DB_FILE=./logiquest.db
# Genera cada token con:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
DOCENTE_TOKEN=
INVESTIGADOR_TOKEN=
# Origen exacto del front (para CORS), p. ej. https://logiquest.ejemplo.edu.co
CORS_ORIGIN=http://localhost:5173
# Pon 1 solo si el servidor está detrás de un proxy de confianza (Nginx, etc.)
TRUST_PROXY=0

# --- Front (se define al compilar con Vite, ver .env.local) ---
# VITE_API_URL=http://localhost:3001
